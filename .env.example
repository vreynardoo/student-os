# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string (Neon). Required starting Phase 1.
# Get this from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Used by Auth.js to sign session JWTs. Required starting Phase 2 (Authentication).
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google Gemini API key. Not read until Phase 7 (AI Academic Advisor).
# The app must run fully without this set — AI features degrade gracefully.
GEMINI_API_KEY=""
